{
  "manifest_version": 3,
  "name": "扩展开关",
  "version": "1.1.1",
  "description": "点一下工具栏图标，快速开关其他扩展。右键某一项还能打开它的详情页、选项页，或复制 ID、卸载。",
  "homepage_url": "https://github.com/SinCircle/ext-switch",
  "permissions": ["management", "storage"],
  "action": {
    "default_title": "扩展开关",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
